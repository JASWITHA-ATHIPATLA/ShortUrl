<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            color: #f4f4f5;
            background: radial-gradient(ellipse at top, #263454 0%, #111827 55%, #090d17 100%);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .card {
            width: min(100%, 560px);
            padding: clamp(28px, 6vw, 48px);
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 24px;
            background: rgba(17, 24, 39, .82);
            box-shadow: 0 24px 80px rgba(0, 0, 0, .35);
        }

        .eyebrow {
            margin: 0 0 12px;
            color: #a5b4fc;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: clamp(2rem, 7vw, 3rem);
            letter-spacing: -.05em;
        }

        .intro {
            margin: 14px 0 30px;
            color: #aab3c5;
            line-height: 1.6;
        }

        form {
            display: grid;
            gap: 12px;
        }

        input {
            width: 100%;
            min-height: 54px;
            padding: 0 16px;
            border: 1px solid #39445b;
            border-radius: 12px;
            color: #f4f4f5;
            background: #111827;
            font: inherit;
        }

        input:focus {
            outline: 3px solid rgba(129, 140, 248, .3);
            border-color: #818cf8;
        }

        input[type="submit"] {
            border: 0;
            color: #111827;
            background: #a5b4fc;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, transform .2s;
        }

        input[type="submit"]:hover {
            background: #c7d2fe;
            transform: translateY(-1px);
        }

        .result {
            margin-top: 24px;
            padding: 18px;
            border: 1px solid rgba(165, 180, 252, .25);
            border-radius: 14px;
            background: rgba(99, 102, 241, .1);
        }

        .result p {
            margin: 0 0 10px;
            color: #c7d2fe;
            font-weight: 650;
        }

        .result a {
            color: #fff;
            overflow-wrap: anywhere;
        }

        .url-list {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, .12);
        }

        .url-list h2 {
            margin: 0 0 16px;
            font-size: 1.2rem;
        }

        .url-item {
            padding: 14px 0;
            border-bottom: 1px solid rgba(255, 255, 255, .1);
        }

        .url-item a {
            color: #c7d2fe;
            overflow-wrap: anywhere;
        }

        .url-item p {
            margin: 8px 0 0;
            color: #aab3c5;
            overflow-wrap: anywhere;
        }
    </style>
</head>
<body>
    <main class="card">
        <p class="eyebrow">Simple link sharing</p>
        <h1>Make your URL shorter.</h1>
        <p class="intro">Paste a long link below and get a short URL you can share anywhere.</p>

        <form action="/url" method="post">
            <input type="url" name="redirectURL" placeholder="https://example.com/your-long-link" required>
            <input type="submit" value="Create short URL">
        </form>

        <% if (shortURL) { %>
            <section class="result" aria-live="polite">
                <p>Your short URL is ready</p>
                <a href="<%= shortURL %>"><%= shortURL %></a>
            </section>
        <% } %>

        <section class="url-list">
            <h2>Your URLs</h2>
            <% if (urls.length === 0) { %>
                <p class="intro">You haven't created any short URLs yet.</p>
            <% } else { %>
                <% urls.forEach((url) => { %>
                    <article class="url-item">
                        <a href="<%= baseURL %>/url/<%= url.shortId %>"><%= baseURL %>/url/<%= url.shortId %></a>
                        <p><%= url.redirectURL %></p>
                    </article>
                <% }); %>
            <% } %>
        </section>
    </main>
</body>
</html>